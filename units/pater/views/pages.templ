package views

templ TripsPage(data DashboardData) {
	<div class="page-shell narrow">
		@PageHeading("Itinerarios", "Todos sus viajes", fmtInt(len(data.Trips)) + " expedientes")
		@TripList(data.Trips, data.Active, false)
	</div>
}

templ TripDetailPage(data TripDetailData) {
	<div class="page-shell narrow">
		@PageHeading("Expediente", data.Trip.Name, StatusLabel(data.Trip.Status))
		@Notice(data.Notice)
		<div class="detail-grid">
			<div>
				@Panel("Reservas del viaje", TripTicket(data.Trip, false))
				@Panel("Compartir itinerario", ShareForm(data.Trip.ID))
			</div>
			<aside class="right-rail">
				@Panel("Viajeros", TravelerList(data.Travelers))
				@Panel("Operaciones", TripActions(data.Trip.ID))
			</aside>
		</div>
	</div>
}

templ TravelerList(items []TravelerView) {
	<ul class="data-list">
		if len(items) == 0 {
			<li class="booking-empty">Sin viajeros asignados.</li>
		}
		for _, t := range items {
			<li><strong>{ t.Name }</strong> <span>{ t.Document }</span></li>
		}
	</ul>
}

templ ShareForm(tripID string) {
	<form class="vintage-form" hx-post={ "/trips/" + tripID + "/share" } hx-target="#share-result" hx-swap="innerHTML">
		<input type="hidden" name="trip_id" value={ tripID } />
		@SubmitButton("Generar enlace de solo lectura", "btn-brass")
	</form>
	<div id="share-result"></div>
}

templ TripActions(tripID string) {
	<div class="action-stack">
		<button class="btn" type="button" hx-post={ "/trips/" + tripID + "/archive" } hx-target="#main-content" hx-swap="innerHTML">Archivar viaje</button>
		<button class="btn ghost" type="button" hx-get={ "/nearby?trip=" + tripID } hx-target="#main-content" hx-swap="innerHTML">Ver cercanías (GPS)</button>
	</div>
}

templ InsightsPage(data InsightPageData) {
	<div class="page-shell narrow">
		@PageHeading("Crónica de viajes", "Boletín de actividad", "Resumen general de sus itinerarios")
		@InsightsPanel(data.Insights)
		@ActivityFeed(data.Activity)
	</div>
}

templ MailboxesPage(items []MailboxView, notice string) {
	<div class="page-shell narrow">
		@PageHeading("Correspondencia", "Buzones conectados", "Recepción automática de confirmaciones")
		@Notice(notice)
		@Panel("Vincular buzón", ConnectMailboxForm())
		@Panel("Buzones", MailboxList(items))
	</div>
}

templ ConnectMailboxForm() {
	<form class="vintage-form" hx-post="/mailboxes" hx-target="#main-content" hx-swap="innerHTML">
		<div class="field-row">
			<label class="field"><span>Proveedor</span>
				<select name="provider"><option value="gmail">Gmail</option><option value="imap">IMAP</option></select>
			</label>
			@Field("Correo", "email", "", "viajero@trotamundos.app", "email", true)
		</div>
		@SubmitButton("Vincular", "btn-brass")
	</form>
}

templ MailboxList(items []MailboxView) {
	<ul class="data-list">
		if len(items) == 0 {
			<li class="booking-empty">No hay buzones vinculados.</li>
		}
		for _, m := range items {
			<li><strong>{ m.Email }</strong> <span>{ m.Provider }</span></li>
		}
	</ul>
}

templ WhitelistsPage(items []SenderView, notice string) {
	<div class="page-shell narrow">
		@PageHeading("Correspondencia", "Remitentes seguros", "Aerolíneas, hoteles y agencias de confianza")
		@Notice(notice)
		@Panel("Agregar remitente", AddSenderForm())
		@Panel("Lista blanca", SenderList(items))
	</div>
}

templ AddSenderForm() {
	<form class="vintage-form" hx-post="/whitelists" hx-target="#main-content" hx-swap="innerHTML">
		@Field("Dominio o correo", "sender", "", "@aerolinea.com", "text", true)
		@SubmitButton("Autorizar", "btn-brass")
	</form>
}

templ SenderList(items []SenderView) {
	<ul class="data-list">
		if len(items) == 0 {
			<li class="booking-empty">No hay remitentes autorizados.</li>
		}
		for _, s := range items {
			<li>
				<strong>{ s.Sender }</strong>
				<button class="del-link" type="button" hx-delete={ "/whitelists/" + s.ID } hx-target="closest li" hx-swap="outerHTML">Quitar</button>
			</li>
		}
	</ul>
}

templ PreferencesPage(p PreferencesData, notice string) {
	<div class="page-shell narrow">
		@PageHeading("Mi cuenta", "Preferencias personales", "Ajustes de idioma, moneda y agencia")
		@Notice(notice)
		@Panel("Datos del expediente", PreferencesForm(p))
	</div>
}

templ PreferencesForm(p PreferencesData) {
	<form class="vintage-form" hx-post="/preferences" hx-target="#main-content" hx-swap="innerHTML">
		@Field("Idioma", "locale", p.Locale, "", "select", false)
		@Field("Moneda", "currency", p.Currency, "USD", "text", true)
		@Field("Radio GPS (km)", "gps_radius_km", p.GpsRadius, "50", "number", false)
		@Field("Agencia preferida", "preferred_agency_id", p.PreferredAgency, "Ej. Agencia Austral", "text", false)
		@SubmitButton("Guardar preferencias", "btn-brass")
	</form>
}

templ SharedPage(data SharedData) {
	<div class="page-shell narrow">
		@PageHeading("Itinerario compartido", data.Trip.Name, "Solo lectura")
		@Panel("Reservas", TripTicket(data.Trip, false))
		@Panel("Viajeros", TravelerList(data.Travelers))
	</div>
}

templ LoginPage(notice string) {
	<div class="page-shell narrow">
		@PageHeading("Oficina central", "Acceso al panel", "Área privada del viajero")
		@Notice(notice)
		@Panel("Identifíquese", LoginForm())
	</div>
}

templ LoginForm() {
	<form class="vintage-form" hx-post="/auth/login" hx-target="#main-content" hx-swap="innerHTML">
		@Field("Correo", "email", "dev@trotamundos.app", "", "email", true)
		@Field("Clave", "password", "", "", "password", true)
		@SubmitButton("Entrar", "btn-brass")
	</form>
	<p class="rail-footnote">Usuario de demostración: dev@trotamundos.app / dev</p>
}

templ NearbyPage(data NearbyData) {
	<div class="page-shell narrow">
		@PageHeading("Geolocalización", "Reservas cercanas", "Búsqueda por ubicación")
		@Panel("Coordenadas", NearbyForm(data))
		@TripList(data.Trips, "", false)
	</div>
}

templ NearbyForm(data NearbyData) {
	<form class="vintage-form" hx-get="/nearby" hx-target="#trip-list" hx-swap="outerHTML">
		<div class="field-row">
			@Field("Latitud", "lat", data.Lat, "-34.6037", "text", true)
			@Field("Longitud", "lon", data.Lon, "-58.3816", "text", true)
			@Field("Radio km", "radius_km", data.Radius, "50", "number", false)
		</div>
		@SubmitButton("Buscar", "btn-brass")
	</form>
}

templ ShareLink(result ShareResult) {
	if result.URL != "" {
		<p class="notice">Enlace generado: <a href={ result.URL } hx-get={ result.URL } hx-target="#main-content" hx-swap="innerHTML">{ result.URL }</a> (vence { result.ExpiresAt })</p>
	} else {
		<p class="notice">No se pudo generar el enlace.</p>
	}
}

templ MapPage(data MapPageData) {
	<div class="page-shell narrow">
		@PageHeading("Cartografía", "Mapa de viajes", fmtInt(data.Total) + " reservas geolocalizadas")
		@Panel("Plano real · OpenStreetMap, estilo café 1930", MapImage(data.Status))
		@Panel("Filtrar por estado del viaje", MapStatusFilters(data))
		@Panel("Leyenda", MapLegend(data))
		<div class="calendar-link">
			<a class="btn" href="/calendar" hx-get="/calendar" hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">Abrir calendario de viajes →</a>
		</div>
	</div>
}

templ MapImage(status string) {
	<div class="map-frame">
		<img class="map-real" src={ "/map/image?status=" + status } alt="Mapa real de los viajes con marcadores y traza por estado" width="880" height="480" />
		<p class="map-credit">Mapa y datos © OpenStreetMap contributors · ODbL · teselas en caché</p>
	</div>
}

templ MapStatusFilters(data MapPageData) {
	<div class="filters" role="group" aria-label="Filtrar mapa por estado">
		<a class={ FilterClass(data.Status, "") } href="/map" hx-get="/map" hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">Todos ({ fmtInt(data.Total) })</a>
		<a class={ FilterClass(data.Status, "upcoming") } href="/map?status=upcoming" hx-get="/map?status=upcoming" hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">Próximos ({ fmtInt(data.Counts["upcoming"]) })</a>
		<a class={ FilterClass(data.Status, "active") } href="/map?status=active" hx-get="/map?status=active" hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">En curso ({ fmtInt(data.Counts["active"]) })</a>
		<a class={ FilterClass(data.Status, "archived") } href="/map?status=archived" hx-get="/map?status=archived" hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">Archivados ({ fmtInt(data.Counts["archived"]) })</a>
	</div>
}

templ MapLegend(data MapPageData) {
	<ul class="map-legend">
		<li><span class="legend-dot legend-bronze"></span> Próximos ({ fmtInt(data.Counts["upcoming"]) })</li>
		<li><span class="legend-dot legend-slate"></span> En curso ({ fmtInt(data.Counts["active"]) })</li>
		<li><span class="legend-dot legend-bordeaux"></span> Archivados ({ fmtInt(data.Counts["archived"]) })</li>
		<li><span class="legend-line"></span> Traza entre reservas del mismo viaje</li>
		<li><span class="legend-note">Cartografía elaborada por la Oficina Central · Datos de OpenStreetMap</span></li>
	</ul>
}

templ AssistantPage(data AssistantPageData) {
	<div class="page-shell narrow">
		@PageHeading("Atención al viajero", "Mostrador de Asistencia", "Consultas rápidas, cambios y gestiones con su agencia")
		@Notice(data.Notice)
		<div class="detail-grid">
			<div>
				@Panel("¿En qué podemos ayudarle hoy?", AssistantForm(data))
				@Panel("Conversación actual", AssistantThread(data.Turns))
			</div>
			<aside class="right-rail">
				@Panel("Su agencia de viajes de confianza", AssistantAgencyCard(data.PreferredAgency))
				@Panel("Gestiones enviadas a su agencia", AssistantCaseList(data.Cases))
			</aside>
		</div>
	</div>
}

templ AssistantForm(data AssistantPageData) {
	<form class="vintage-form" hx-post="/assistant/messages" hx-target="#main-content" hx-swap="innerHTML">
		if len(data.Trips) > 0 {
			<label class="field">
				<span>Viaje sobre el que consulta (opcional)</span>
				<select name="trip_id">
					<option value="">— Todos mis viajes —</option>
					for _, t := range data.Trips {
						<option value={ t.ID }>{ t.Name } ({ StatusLabel(t.Status) })</option>
					}
				</select>
			</label>
		}
		@Field("Su consulta", "message", "", "Ej.: ¿En qué estado están mis reservas para Madrid?", "text", true)
		@SubmitButton("Enviar consulta", "btn-brass")
	</form>
	<div class="filters" role="group" aria-label="Consultas frecuentes">
		<button class="filter-chip" type="button" hx-post="/assistant/messages" hx-vals='{"message":"¿En qué estado están mis próximos viajes y reservas?"}' hx-target="#main-content" hx-swap="innerHTML">Consultar estado de mis reservas</button>
		<button class="filter-chip" type="button" hx-post="/assistant/messages" hx-vals='{"message":"Necesito cambiar la fecha de mi vuelo"}' hx-target="#main-content" hx-swap="innerHTML">Cambiar fecha de un viaje</button>
		<button class="filter-chip" type="button" hx-post="/assistant/messages" hx-vals='{"message":"¿Qué equipaje y documentos necesito para el check-in?"}' hx-target="#main-content" hx-swap="innerHTML">Equipaje y documentación</button>
		<button class="filter-chip" type="button" hx-post="/assistant/messages" hx-vals='{"message":"Solicito un reembolso y gestión especial con mi agencia"}' hx-target="#main-content" hx-swap="innerHTML">Solicitar gestión a mi agencia</button>
	</div>
}

templ AssistantThread(turns []AssistantTurnView) {
	<div id="assistant-thread">
		if len(turns) == 0 {
			@EmptyState("Aún no ha iniciado una conversación. Escriba su consulta arriba o elija una de las opciones frecuentes.")
		} else {
			<ol class="timeline">
				for _, turn := range turns {
					<li class="timeline-item">
						<span class="timeline-dot"></span>
						<div>
							<strong>Usted: { turn.UserMessage }</strong>
							<p><span class="stamp">{ IntentLabel(turn.Intent) }</span></p>
							<p>{ turn.Answer }</p>
							if turn.DeepLinkURL != "" {
								<p>
									<a class="btn btn-small" href={ turn.DeepLinkURL } target="_blank" rel="noopener noreferrer">{ turn.ActionLabel }</a>
								</p>
							}
						</div>
					</li>
				}
			</ol>
		}
	</div>
}

templ AssistantAgencyCard(agency string) {
	<p>Agencia asignada: <strong>{ agency }</strong></p>
	<p class="rail-footnote">Puede elegir otra agencia en <a href="/preferences" hx-get="/preferences" hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">Preferencias</a>. Para su tranquilidad, cuando una gestión requiere atención personalizada enviamos a su agencia únicamente los datos esenciales del viaje.</p>
}

templ AssistantCaseList(cases []AssistanceCaseView) {
	<div id="assistant-cases">
		<ul class="data-list">
			if len(cases) == 0 {
				<li class="booking-empty">No hay gestiones pendientes con su agencia.</li>
			}
			for _, c := range cases {
				<li>
					<div>
						<strong>Gestión #{ c.ID }</strong> · <span class="stamp">{ StatusLabel(c.Status) }</span>
						<p>Agencia: <strong>{ c.AgencyID }</strong> · { ReasonLabel(c.Reason) } ({ SeverityLabel(c.Severity) })</p>
						if c.Status == "open" {
							<button class="btn btn-small" type="button" hx-post={ "/assistant/cases/" + c.ID + "/handoff" } hx-target="#main-content" hx-swap="innerHTML">Confirmar recepción por la agencia</button>
						}
						if c.Status == "open" || c.Status == "handed_off" {
							<button class="btn btn-small ghost" type="button" hx-post={ "/assistant/cases/" + c.ID + "/resolve" } hx-target="#main-content" hx-swap="innerHTML">Marcar como resuelto</button>
						}
					</div>
				</li>
			}
		</ul>
	</div>
}

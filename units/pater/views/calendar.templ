package views

templ CalendarPage(cal CalendarMonth) {
	<div class="page-shell narrow">
		@PageHeading("Oficina central", "Calendario de viajes", cal.Label)
		<div class="calendar-toolbar">
			<a class="btn ghost" href={ "/calendar?month=" + cal.Prev } hx-get={ "/calendar?month=" + cal.Prev } hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">← Mes anterior</a>
			<strong class="calendar-title">{ cal.Label }</strong>
			<a class="btn ghost" href={ "/calendar?month=" + cal.Next } hx-get={ "/calendar?month=" + cal.Next } hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">Mes siguiente →</a>
		</div>
		<div class="agenda-sheet">
			<div class="agenda-masthead">
				<span class="agenda-mark" aria-hidden="true">✦</span>
				<div class="agenda-heading">
					<span class="agenda-kicker">Compañía Trotamundos · Libro de itinerarios</span>
					<h3 class="agenda-month">{ cal.Label }</h3>
				</div>
				<span class="agenda-folio">Folio { cal.Key }</span>
			</div>
			<div class="calendar-grid">
				<table class="agenda-table">
					<thead>
						<tr>
							<th class="agenda-weeknum" scope="col">Sem.</th>
							for _, dia := range []string{"Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo"} {
								<th class="agenda-weekday" scope="col">{ dia }</th>
							}
						</tr>
					</thead>
					<tbody>
						for _, week := range cal.Weeks {
							<tr>
								<th class="agenda-weeknum" scope="row">{ fmtInt(week.Number) }</th>
								for _, day := range week.Days {
									<td class={ CalendarDayClass(day) }>
										<span class="calendar-daynum">{ fmtInt(day.Number) }</span>
										for _, trip := range day.Trips {
											<span class={ "calendar-trip " + StatusClass(trip.Status) } title={ trip.Name }>{ trip.Name }</span>
										}
									</td>
								}
							</tr>
						}
					</tbody>
				</table>
			</div>
			<div class="agenda-foot">
				<span>Asientos del mes · registros de la Oficina Central</span>
				<span>Buenos Aires, MCMXXX</span>
			</div>
		</div>
		@Panel("Leyenda del calendario", CalendarLegend())
		if len(cal.Undated) > 0 {
			@Panel("Viajes sin fechas", CalendarUndated(cal.Undated))
		}
		<div class="calendar-link">
			<a class="btn" href="/map" hx-get="/map" hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">Ver mapa de viajes →</a>
		</div>
	</div>
}

templ CalendarLegend() {
	<ul class="map-legend">
		<li><span class="legend-dot legend-bronze"></span> Próximos viajes</li>
		<li><span class="legend-dot legend-slate"></span> Viajes en curso</li>
		<li><span class="legend-dot legend-bordeaux"></span> Viajes archivados</li>
	</ul>
}

templ CalendarUndated(trips []TripView) {
	<ul class="ledger-list">
		for _, trip := range trips {
			<li>
				<span class="ledger-dot"></span>
				<strong>{ trip.Name }</strong>
				<span class={ "ledger-status " + StatusClass(trip.Status) }>{ StatusLabel(trip.Status) }</span>
			</li>
		}
	</ul>
}

# Trotamundos — Variables de entorno (Fase 0)
# Copiar a deploy/.env y ajustar. NO commitear secretos reales.

# --- Pater (Gateway + Web BFF + Mobile BFF) ---
PATER_PG_DSN=postgres://trotamundos:dev@localhost:5432/trotamundos?sslmode=disable&search_path=pater
PATER_REDIS_URL=redis://localhost:6379/0
JWT_PRIVATE_KEY_FILE=./secrets/pater_jwt_private.pem
JWT_PUBLIC_KEY_FILE=./secrets/pater_jwt_public.pem
PATER_PORT=8080
PATER_FILIUS_URL=http://filius:8081
PATER_SPIRITUS_URL=http://spiritus:8082

# --- Filius (Itinerary + Integration) ---
FILIUS_PG_DSN=postgres://trotamundos:dev@localhost:5432/trotamundos?sslmode=disable&search_path=filius
FILIUS_REDIS_URL=redis://localhost:6379/1
NATS_URL=nats://nats:4222
FILIUS_PORT=8081

# --- Spiritus (Email Ingest + Analytics) ---
SPIRITUS_PG_DSN=postgres://trotamundos:dev@localhost:5432/trotamundos?sslmode=disable&search_path=spiritus
SPIRITUS_REDIS_URL=redis://localhost:6379/2
SPIRITUS_CH_DSN=clickhouse://default:@clickhouse:9000/trotamundos
NATS_URL=nats://nats:4222
SPIRITUS_PORT=8082

# --- Integraciones externas ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# --- Observabilidad ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=info
ENVIRONMENT=development

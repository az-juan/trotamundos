# Trotamundos — Variables de entorno (Fase 0)
# Copiar a deploy/.env y ajustar. NO commitear secretos reales.

# --- Pater (Rostro · Web BFF SSR + HTMX + sqlc; ADR-111) ---
# Sin BFF móvil, JWT ni JWKS en Fase 0 (DT-08).
PATER_PG_DSN=postgres://pater_app:***@localhost:55432/trotamundos?sslmode=disable
SESSION_SECRET=***
PATER_PORT=8080

# --- Asistente Virtual (Fase 1, ADR-109/110) — no activar en Fase 0 ---
# ASSISTANT_ENABLED=false
# ASSISTANT_LLM_BASE_URL=
# ASSISTANT_LLM_API_KEY_FILE=./secrets/pater_assistant_llm.key
# ASSISTANT_SESSION_TTL_MIN=30
# ASSISTANT_HANDOFF_TOKEN_TTL_MIN=15

# --- Filius (Núcleo · OLTP + webhooks) ---
FILIUS_PG_DSN=postgres://filius_app:***@localhost:55432/trotamundos?sslmode=disable&search_path=filius
FILIUS_REDIS_URL=redis://localhost:6379/1
NATS_URL=nats://nats:4222
FILIUS_PORT=8081
# URL usada solo por el fallback HTTP de Filius -> Spiritus cuando NATS no está disponible
SPIRITUS_URL=http://spiritus:8082

# --- Spiritus (Mente · ingesta y analítica) ---
SPIRITUS_PG_DSN=postgres://spiritus_app:***@localhost:55432/trotamundos?sslmode=disable&search_path=spiritus
SPIRITUS_REDIS_URL=redis://localhost:6379/2
# Driver analítico por fase (ADR-107): 'postgres' en Fase 0 -> 'clickhouse' en Fase 1
SPIRITUS_ANALYTICS_DRIVER=postgres
SPIRITUS_CH_DSN=clickhouse://default:@clickhouse:9000/trotamundos
SPIRITUS_PORT=8082

# --- Integraciones externas ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# --- Observabilidad ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=info
ENVIRONMENT=development

# --- Puertos host del despliegue Docker Compose (evitan colisiones locales) ---
# NGINX_HTTP_PORT=8088
# NGINX_HTTPS_PORT=8443
# PATER_HOST_PORT=8090
# POSTGRES_HOST_PORT=55432

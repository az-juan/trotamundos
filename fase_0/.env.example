# Trotamundos — Variables de entorno (Fase 0)
# Copiar a deploy/.env y ajustar. NO commitear secretos reales.

# --- Pater (Gateway + Web BFF + Mobile BFF) ---
# Rol RBAC exclusivo del esquema pater (ADR-108)
PATER_PG_DSN=postgres://pater_app:pater_dev@localhost:5432/trotamundos?sslmode=disable&search_path=pater
PATER_REDIS_URL=redis://localhost:6379/0
JWT_PRIVATE_KEY_FILE=./secrets/pater_jwt_private.pem
JWT_PUBLIC_KEY_FILE=./secrets/pater_jwt_public.pem
PATER_PORT=8080
PATER_FILIUS_URL=http://filius:8081
PATER_SPIRITUS_URL=http://spiritus:8082

# --- Asistente Virtual (Fase 1, ADR-109/110) — no activar en Fase 0 ---
# ASSISTANT_ENABLED=false
# ASSISTANT_LLM_BASE_URL=
# ASSISTANT_LLM_API_KEY_FILE=./secrets/pater_assistant_llm.key
# ASSISTANT_SESSION_TTL_MIN=30
# ASSISTANT_HANDOFF_TOKEN_TTL_MIN=15

# --- Filius (Itinerary + Integration) ---
# Rol RBAC exclusivo del esquema filius (ADR-108)
FILIUS_PG_DSN=postgres://filius_app:filius_dev@localhost:5432/trotamundos?sslmode=disable&search_path=filius
FILIUS_REDIS_URL=redis://localhost:6379/1
NATS_URL=nats://nats:4222
FILIUS_PORT=8081

# --- Spiritus (Email Ingest + Analytics) ---
# Rol RBAC exclusivo del esquema spiritus (ADR-108)
SPIRITUS_PG_DSN=postgres://spiritus_app:spiritus_dev@localhost:5432/trotamundos?sslmode=disable&search_path=spiritus
SPIRITUS_REDIS_URL=redis://localhost:6379/2
# Driver analítico por fase (ADR-107): 'postgres' en Fase 0 -> 'clickhouse' en Fase 1
SPIRITUS_ANALYTICS_DRIVER=postgres
SPIRITUS_CH_DSN=clickhouse://default:@clickhouse:9000/trotamundos
NATS_URL=nats://nats:4222
SPIRITUS_PORT=8082

# --- Integraciones externas ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# --- Observabilidad ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=info
ENVIRONMENT=development
